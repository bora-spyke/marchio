<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="screens" class="screens" picking-mode="Ignore">
        <ui:VisualElement name="main" class="overlay overlay--main">
            <ui:VisualElement class="main-hero">
                <ui:Label class="title title--hero" text="NEONLOOP" />
                <ui:Label class="subtitle subtitle--tight" text="TRACE  ·  CLAIM  ·  SURVIVE" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:VisualElement name="main-buttons" class="buttons buttons--main" />
        </ui:VisualElement>
        <ui:VisualElement name="clear" class="overlay">
            <ui:Label name="clear-title" class="title-small" text="LEVEL 1 COMPLETE" />
            <ui:VisualElement name="clear-lines" class="panel" />
            <ui:VisualElement name="clear-stack" class="stack-row panel" />
            <ui:Label name="clear-hp" class="hp-line" text="HP 100 / 100" />
            <ui:VisualElement name="clear-buttons" class="buttons" />
        </ui:VisualElement>
        <ui:VisualElement name="fill" class="overlay">
            <ui:Label name="fill-title" class="title-small" text="LEVEL 1 COMPLETE" />
            <ui:VisualElement name="fill-cards" class="cards" />
            <ui:Label class="choose-prompt" text="Choose one to continue" />
        </ui:VisualElement>
        <ui:VisualElement name="power" class="overlay">
            <ui:Label name="power-title" class="title-small" text="LEVEL 2" />
            <ui:VisualElement name="power-cards" class="cards" />
            <ui:Label class="choose-prompt" text="Choose one to continue" />
        </ui:VisualElement>
        <ui:VisualElement name="fail" class="overlay">
            <ui:VisualElement class="popup">
                <ui:VisualElement class="popup-body">
                    <ui:VisualElement class="popup-inside">
                        <ui:VisualElement class="popup-heart" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fail-buttons" class="popup-buttons" />
                </ui:VisualElement>
                <ui:VisualElement class="popup-header">
                    <ui:VisualElement class="popup-header-bg popup-header-bg--left" />
                    <ui:VisualElement class="popup-header-bg popup-header-bg--right" />
                    <ui:Label class="popup-title" text="RUN OVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="victory" class="overlay">
            <ui:Label class="title" text="VICTORY LAP" />
            <ui:Label name="victory-score" class="subtitle subtitle--tight" text="RUN SCORE: 0" />
            <ui:VisualElement name="victory-buttons" class="buttons" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
