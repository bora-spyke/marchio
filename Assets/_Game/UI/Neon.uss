
.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: #eaf6ff;
}

.top-row {
    position: absolute;
    left: 13px;
    right: 13px;
    top: 19px;
    flex-direction: row;
    align-items: center;
}

.stage-badge {
    width: 124px;
    height: 40px;
    background-image: url("project://database/Assets/_aa/board.png?fileID=21300000&guid=66e6b52bf07eb4ac9858ab14fc08f49d&type=3#board");
    -unity-slice-left: 65;
    -unity-slice-right: 65;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
    align-items: center;
    justify-content: center;
    padding-bottom: 3px;
}

.stage-text {
    -unity-font: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy.otf?fileID=12800000&guid=c6abca83b4e5d4904a783b871d4bae95&type=3#EigerdalsNormHeavy");
    -unity-font-definition: none;
    font-size: 19px;
    -unity-font-style: normal;
    color: #ffffff;
    letter-spacing: 0;
    -unity-text-outline-width: 0.9px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.8);
}

.hp-group {
    flex-direction: row;
    align-items: center;
    margin-left: 13px;
    height: 41px;
}

.hp-heart {
    position: absolute;
    left: 0;
    top: 0;
    width: 42px;
    height: 41px;
    background-image: url("project://database/Assets/_aa/heart.png?fileID=21300000&guid=226c31b52685643a9946f8a7689d2d9e&type=3#heart");
}

.hp-track {
    margin-left: 34px;
    width: 166px;
    height: 25px;
    background-image: url("project://database/Assets/_aa/Progress.png?fileID=21300000&guid=eea326ef6354946438d1b5d8d478d976&type=3#Progress");
    -unity-slice-left: 75;
    -unity-slice-right: 75;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
    padding: 3px 4px 4px 4px;
    justify-content: center;
}

.hp-fill {
    height: 100%;
    width: 100%;
    min-width: 14px;
    background-image: url("project://database/Assets/_aa/Progress Blue.png?fileID=21300000&guid=75d81d2a724454a0889ec10bf383fa13&type=3#Progress Blue");
    -unity-slice-left: 45;
    -unity-slice-right: 45;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
    transition-property: width;
    transition-duration: 0.12s;
}

.hp-track--low .hp-fill {
    -unity-background-image-tint-color: #ff8a8a;
}

.top-left {
    position: absolute;
    left: 14px;
    top: 70px;
}

.top-right {
    position: absolute;
    right: 14px;
    top: 70px;
    align-items: flex-end;
}

.top-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 70px;
    align-items: center;
}

.bar {
    border-radius: 7px;
    overflow: hidden;
    background-color: rgba(255, 77, 109, 0.14);
    border-width: 1.5px;
    border-color: rgba(125, 252, 255, 0.35);
}

.bar-fill {
    height: 100%;
    width: 100%;
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.hp-bar--low .combo-chip {
    margin-top: 8px;
    padding: 4px 11px;
    border-radius: 11px;
    background-color: #ffb020;
    color: #1a1206;
    font-size: 13px;
    -unity-font-style: bold;
    opacity: 0;
    scale: 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.combo-chip--on {
    opacity: 1;
    scale: 1;
}

.draw-text {
    color: #7dfcff;
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 2px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.draw-text--on {
    opacity: 1;
}

.trail-bar {
    width: 120px;
    height: 4px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    opacity: 0;
}

.trail-bar--on {
    opacity: 1;
}

.trail-fill {
    height: 100%;
    width: 0;
    background-color: #7dfcff;
}

.trail-fill--hot {
    background-color: #ff4d6d;
}

.damage-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dmg {
    position: absolute;
    color: #eaf6ff;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 60px;
    margin-left: -30px;
}

.joystick {
    position: absolute;
    width: 120px;
    height: 120px;
    margin-left: -60px;
    margin-top: -60px;
    border-radius: 60px;
    border-width: 1.5px;
    border-color: rgba(125, 252, 255, 0.35);
    background-color: rgba(125, 252, 255, 0.05);
    display: none;
    align-items: center;
    justify-content: center;
}

.joystick-knob {
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(125, 252, 255, 0.55);
}

.screens {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: #eaf6ff;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 5, 10, 0.82);
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.overlay--visible {
    opacity: 1;
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    color: #eaf6ff;
    text-shadow: 0 0 18px #7dfcff;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.title-small {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.subtitle {
    font-size: 14px;
    color: rgba(234, 246, 255, 0.85);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 320px;
    margin-bottom: 40px;
}

.cta {
    font-size: 14px;
    -unity-font-style: bold;
    opacity: 0.55;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.cta--pulse {
    opacity: 1;
}

.cards {
    align-items: stretch;
    width: 300px;
    max-width: 90%;
}

.card {
    flex-direction: row;
    align-items: center;
    height: 72px;
    margin: 0 0 14px 0;
    padding: 0 12px 0 14px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: rgba(125, 252, 255, 0.28);
    background-color: rgba(125, 252, 255, 0.05);
    color: #eaf6ff;
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate, scale, background-color;
    transition-duration: 0.28s, 0.28s, 0.08s, 0.08s;
    transition-timing-function: ease-out;
}

.card--in {
    opacity: 1;
    translate: 0 0;
}

.card:active {
    scale: 0.96;
    background-color: rgba(125, 252, 255, 0.16);
}

.card-badge {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    margin-right: 14px;
    flex-shrink: 0;
}

.card-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.card-name {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.card-desc {
    font-size: 11px;
    color: rgba(234, 246, 255, 0.65);
    white-space: normal;
    -unity-text-align: middle-left;
}

.threshold-bar {
    width: 200px;
    max-width: 60%;
    height: 10px;
    border-color: rgba(125, 252, 255, 0.45);
    background-color: rgba(125, 252, 255, 0.08);
    transition-property: border-color, background-color;
    transition-duration: 0.25s;
}

.threshold-fill {
    background-color: #7dfcff;
    width: 0;
}

.threshold-bar--pressure {
    border-color: rgba(255, 176, 32, 0.8);
}

.threshold-bar--pressure .threshold-fill {
    background-color: #ffb020;
}

.threshold-bar--pulse {
    border-color: rgba(255, 77, 109, 1);
    background-color: rgba(255, 77, 109, 0.25);
}

.threshold-text {
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 3px;
    color: rgba(234, 246, 255, 0.85);
}

.stack-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.stack-row--hud {
    justify-content: flex-start;
    max-width: 130px;
}

.stack-chip {
    flex-direction: row;
    align-items: center;
    padding: 2px 7px;
    margin: 0 4px 4px 0;
    border-radius: 9px;
    background-color: rgba(125, 252, 255, 0.08);
    border-width: 1px;
    border-color: rgba(125, 252, 255, 0.25);
    transition-property: opacity;
    transition-duration: 0.9s;
}

.stack-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 5px;
}

.stack-text {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(234, 246, 255, 0.9);
}

.stack-empty {
    font-size: 10px;
    color: rgba(234, 246, 255, 0.45);
}

.stack-row--dark .stack-chip {
    opacity: 0.18;
}

.toast {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    align-items: center;
    opacity: 0;
    scale: 0.8;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.toast--on {
    opacity: 1;
    scale: 1;
}

.toast-text {
    padding: 8px 18px;
    border-radius: 14px;
    background-color: rgba(125, 252, 255, 0.16);
    border-width: 1.5px;
    border-color: #7dfcff;
    color: #eaf6ff;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.toast--macro .toast-text {
    background-color: rgba(255, 216, 77, 0.2);
    border-color: #ffd84d;
    font-size: 18px;
}

.overlay--main {
    justify-content: flex-start;
}

.overlay--main > .title {
    margin-top: 60px;
}

.safe {
    flex-grow: 1;
}

.subtitle--tight {
    margin-bottom: 14px;
}

.panel {
    width: 320px;
    max-width: 92%;
    margin-bottom: 14px;
}

.panel-title {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(234, 246, 255, 0.6);
    margin-bottom: 4px;
}

.trophy-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.trophy-next {
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffd84d;
}

.trophy-remain {
    font-size: 11px;
    color: rgba(234, 246, 255, 0.75);
}

.trophy-bar {
    width: 100%;
    height: 10px;
    border-color: rgba(255, 216, 77, 0.5);
    background-color: rgba(255, 216, 77, 0.1);
}

.trophy-fill {
    background-color: #ffd84d;
    width: 0;
    transition-duration: 0s;
}

.road {
    width: 320px;
    max-width: 92%;
    max-height: 340px;
    margin-bottom: 12px;
}

.road-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.road-col-title {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(234, 246, 255, 0.5);
    width: 48%;
}

.node {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.node-free {
    flex-direction: row;
    align-items: center;
    width: 48%;
    padding: 6px 8px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: rgba(125, 252, 255, 0.28);
    background-color: rgba(125, 252, 255, 0.05);
}

.node--macro .node-free {
    border-color: rgba(255, 216, 77, 0.7);
    background-color: rgba(255, 216, 77, 0.08);
    padding: 12px 10px;
}

.node--claimed .node-free {
    opacity: 0.45;
}

.node-badge {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(125, 252, 255, 0.2);
}

.node--macro .node-badge {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(255, 216, 77, 0.3);
}

.node-title {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.node--macro .node-title {
    font-size: 14px;
}

.node-sub {
    font-size: 10px;
    color: rgba(234, 246, 255, 0.6);
}

.node-premium {
    width: 48%;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(234, 246, 255, 0.12);
}

.cart-preview {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(234, 246, 255, 0.8);
    margin-bottom: 14px;
}

.buttons {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    margin: 6px;
    padding: 12px 26px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #7dfcff;
    background-color: rgba(125, 252, 255, 0.12);
    color: #eaf6ff;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.btn:active {
    background-color: rgba(125, 252, 255, 0.3);
    scale: 0.96;
}

.btn--primary {
    background-color: rgba(125, 252, 255, 0.28);
}

.btn--ghost {
    border-color: rgba(234, 246, 255, 0.25);
    background-color: rgba(0, 0, 0, 0);
    color: rgba(234, 246, 255, 0.7);
    font-size: 12px;
    padding: 9px 16px;
}

.line {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.line-name {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(234, 246, 255, 0.75);
}

.line-value {
    font-size: 16px;
    -unity-font-style: bold;
}

.line--bonus .line-name {
    color: #ffd84d;
}

.line--bonus .line-value {
    color: #ffd84d;
}

.hp-line {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(234, 246, 255, 0.85);
    margin-bottom: 18px;
}

.missed {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ff4d6d;
    margin: 6px 0 18px 0;
}

.card-stack {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(234, 246, 255, 0.6);
    margin-left: 8px;
    flex-shrink: 0;
}

.card--distinct {
    border-color: #ff4d6d;
    background-color: rgba(255, 77, 109, 0.12);
}

.card--distinct .card-desc {
    color: #ff8fa3;
}

.rewards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 320px;
    max-width: 92%;
    margin-bottom: 18px;
}

.reward {
    width: 140px;
    margin: 6px;
    padding: 10px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(255, 216, 77, 0.7);
    background-color: rgba(255, 216, 77, 0.1);
    align-items: center;
}

.reward--locked {
    opacity: 0.3;
}

.reward-star {
    font-size: 20px;
    color: #ffd84d;
}

.reward-title {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}
