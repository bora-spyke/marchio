.hud Label, .screens Label, .screens Button {
    -unity-font-definition: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy%20SDF.asset?fileID=11400000&guid=60c70ae7553fa4383ba3534dd23d4ebb&type=2#EigerdalsNormHeavy SDF");
    -unity-font-style: normal;
}


.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: #eaf6ff;
}

.top-row {
    position: absolute;
    left: 13px;
    right: 13px;
    top: 19px;
    flex-direction: row;
    align-items: center;
}

.stage-badge {
    width: 124px;
    height: 40px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/board.png?fileID=21300000&guid=66e6b52bf07eb4ac9858ab14fc08f49d&type=3#board");
    -unity-slice-left: 65;
    -unity-slice-right: 65;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
    align-items: center;
    justify-content: center;
}

.stage-text {
    width: 100%;
    -unity-text-align: middle-center;
    translate: 0 -2px;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy%20SDF.asset?fileID=11400000&guid=60c70ae7553fa4383ba3534dd23d4ebb&type=2#EigerdalsNormHeavy SDF");
    font-size: 19px;
    -unity-font-style: normal;
    color: #ffffff;
    letter-spacing: 0;
    -unity-text-outline-width: 0.9px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.8);
}

.hp-group {
    flex-direction: row;
    align-items: center;
    margin-left: 13px;
    height: 41px;
}

.hp-heart {
    position: absolute;
    left: 0;
    top: 0;
    width: 42px;
    height: 41px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/heart.png?fileID=21300000&guid=226c31b52685643a9946f8a7689d2d9e&type=3#heart");
}

.hp-track {
    margin-left: 21px;
    width: 166px;
    height: 25px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/Progress.png?fileID=21300000&guid=eea326ef6354946438d1b5d8d478d976&type=3#Progress");
    -unity-slice-left: 75;
    -unity-slice-right: 75;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
    padding: 2px 4px 5px 4px;
    justify-content: center;
}

.hp-fill {
    height: 100%;
    width: 100%;
    min-width: 14px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/Progress Blue.png?fileID=21300000&guid=75d81d2a724454a0889ec10bf383fa13&type=3#Progress Blue");
    -unity-slice-left: 45;
    -unity-slice-right: 45;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
    transition-property: width;
    transition-duration: 0.12s;
}

.hp-track--low .hp-fill {
    -unity-background-image-tint-color: #ff8a8a;
}

.top-left {
    position: absolute;
    left: 14px;
    top: 86px;
}

.top-right {
    position: absolute;
    right: 14px;
    top: 70px;
    align-items: flex-end;
}

.top-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 70px;
    align-items: center;
}

.bar {
    border-radius: 7px;
    overflow: hidden;
    background-color: rgba(255, 77, 109, 0.14);
    border-width: 1.5px;
    border-color: rgba(125, 252, 255, 0.35);
}

.bar-fill {
    height: 100%;
    width: 100%;
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.hp-bar--low .combo-chip {
    margin-top: 8px;
    padding: 4px 11px;
    border-radius: 11px;
    background-color: #ffb020;
    color: #1a1206;
    font-size: 13px;
    -unity-font-style: bold;
    opacity: 0;
    scale: 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.combo-chip--on {
    opacity: 1;
    scale: 1;
}

.draw-text {
    color: #7dfcff;
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 2px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.draw-text--on {
    opacity: 1;
}

.trail-bar {
    width: 120px;
    height: 4px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    opacity: 0;
}

.trail-bar--on {
    opacity: 1;
}

.trail-fill {
    height: 100%;
    width: 0;
    background-color: #7dfcff;
}

.trail-fill--hot {
    background-color: #ff4d6d;
}

.damage-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dmg {
    position: absolute;
    color: #eaf6ff;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 60px;
    margin-left: -30px;
}

.joystick {
    position: absolute;
    width: 120px;
    height: 120px;
    margin-left: -60px;
    margin-top: -60px;
    border-radius: 60px;
    border-width: 1.5px;
    border-color: rgba(125, 252, 255, 0.35);
    background-color: rgba(125, 252, 255, 0.05);
    display: none;
    align-items: center;
    justify-content: center;
}

.joystick-knob {
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(125, 252, 255, 0.55);
}

.screens {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: #eaf6ff;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 5, 10, 0.82);
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.overlay--visible {
    opacity: 1;
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    color: #eaf6ff;
    text-shadow: 0 0 18px #7dfcff;
    letter-spacing: 3px;
    margin-bottom: 10px;
    -unity-font-definition: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy%20SDF.asset?fileID=11400000&guid=60c70ae7553fa4383ba3534dd23d4ebb&type=2#EigerdalsNormHeavy SDF");
}

.title-small {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.subtitle {
    font-size: 14px;
    color: rgba(234, 246, 255, 0.85);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 320px;
    margin-bottom: 40px;
}

.cta {
    font-size: 14px;
    -unity-font-style: bold;
    opacity: 0.55;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.cta--pulse {
    opacity: 1;
}

.wave-bar--pressure .stack-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.stack-row--hud {
    justify-content: flex-start;
    max-width: 130px;
}

.stack-chip {
    flex-direction: row;
    align-items: center;
    padding: 2px 7px;
    margin: 0 4px 4px 0;
    border-radius: 9px;
    background-color: rgba(125, 252, 255, 0.08);
    border-width: 1px;
    border-color: rgba(125, 252, 255, 0.25);
    transition-property: opacity;
    transition-duration: 0.9s;
}

.stack-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 5px;
}

.stack-text {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(234, 246, 255, 0.9);
}

.stack-empty {
    font-size: 10px;
    color: rgba(234, 246, 255, 0.45);
}

.stack-row--dark .stack-chip {
    opacity: 0.18;
}

.overlay--main {
    justify-content: space-between;
    padding: 0 22px 70px 22px;
    background-color: rgba(0, 0, 0, 0);
}

.main-hero {
    align-items: center;
    margin-top: 54px;
    margin-bottom: 18px;
}

.title--hero {
    font-size: 44px;
    letter-spacing: 6px;
    margin-bottom: 4px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(125, 252, 255, 0.35);
}

.spacer {
    flex-grow: 1;
}

.buttons--main {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
}

.buttons--main .btn--primary {
    height: 58px;
    margin: 0 0 6px 0;
    border-radius: 29px;
    border-width: 0;
    background-color: #7dfcff;
    color: #05121a;
    font-size: 20px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.buttons--main .btn--primary:active {
    background-color: #b9fdff;
    scale: 0.97;
}

.buttons--main .btn--ghost {
    align-self: center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(234, 246, 255, 0.4);
    font-size: 11px;
    letter-spacing: 2px;
    padding: 6px 12px;
    margin: 0;
}

.safe {
    flex-grow: 1;
}

.subtitle--tight {
    margin-bottom: 14px;
}

.panel {
    width: 320px;
    max-width: 92%;
    margin-bottom: 14px;
}

.panel-title {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(234, 246, 255, 0.6);
    margin-bottom: 4px;
}

.buttons {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    margin: 6px;
    padding: 12px 26px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #7dfcff;
    background-color: rgba(125, 252, 255, 0.12);
    color: #eaf6ff;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.btn:active {
    background-color: rgba(125, 252, 255, 0.3);
    scale: 0.96;
}

.btn--primary {
    background-color: rgba(125, 252, 255, 0.28);
}

.btn--ghost {
    border-color: rgba(234, 246, 255, 0.25);
    background-color: rgba(0, 0, 0, 0);
    color: rgba(234, 246, 255, 0.7);
    font-size: 12px;
    padding: 9px 16px;
}

.line {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.line-name {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(234, 246, 255, 0.75);
}

.line-value {
    font-size: 16px;
    -unity-font-style: bold;
}

.line--bonus .line-name {
    color: #ffd84d;
}

.line--bonus .line-value {
    color: #ffd84d;
}

.hp-line {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(234, 246, 255, 0.85);
    margin-bottom: 18px;
}

.card--distinct 
.font-hero {
    -unity-font-definition: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy%20SDF.asset?fileID=11400000&guid=60c70ae7553fa4383ba3534dd23d4ebb&type=2#EigerdalsNormHeavy SDF");
    -unity-font-style: normal;
}

.choose-prompt {
    margin-top: 44px;
    font-size: 19px;
    color: #ffffff;
    -unity-text-outline-width: 0.8px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.75);
}

.cards {
    align-items: stretch;
    width: 304px;
    max-width: 90%;
    margin-top: 24px;
}

.card {
    position: relative;
    height: 74px;
    margin: 0 0 22px 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s, 0.28s, 0.08s;
    transition-timing-function: ease-out;
}

.card--in {
    opacity: 1;
    translate: 0 0;
}

.card:active {
    scale: 0.96;
}

.card-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background-image: url("project://database/Assets/_Game/UI/Sprites/Fill board.png?fileID=21300000&guid=1e3b07ade5b314a2ca103e62d838adff&type=3#Fill board");
    -unity-slice-left: 0;
    -unity-slice-right: 110;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.33px;
}

.card-bg--left {
    left: 0;
    scale: -1 1;
}

.card-bg--right {
    right: 0;
}

.card-text {
    position: absolute;
    left: 60px;
    right: 44px;
    top: 0;
    bottom: 0;
    justify-content: center;
}

.card-name {
    -unity-font-definition: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy%20SDF.asset?fileID=11400000&guid=60c70ae7553fa4383ba3534dd23d4ebb&type=2#EigerdalsNormHeavy SDF");
    font-size: 18px;
    color: #f7c948;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0.7px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
    text-shadow: 0 1.5px 0 rgba(0, 0, 0, 0.7);
}

.card-desc {
    -unity-font-definition: url("project://database/Assets/_Game/Fonts/EigerdalsNormHeavy%20SDF.asset?fileID=11400000&guid=60c70ae7553fa4383ba3534dd23d4ebb&type=2#EigerdalsNormHeavy SDF");
    font-size: 11px;
    color: #ffffff;
    white-space: normal;
    -unity-text-align: middle-left;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.7);
}

.card-icon {
    position: absolute;
    left: -22px;
    top: -6px;
    width: 82px;
    height: 84px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-icon--heal {
    background-image: url("project://database/Assets/_Game/UI/Sprites/Heal Fill icon.png?fileID=21300000&guid=5f73086b3ea2b4ea59797c065f36e280&type=3#Heal Fill icon");
}

.card-icon--burning {
    background-image: url("project://database/Assets/_Game/UI/Sprites/Burning Fill.png?fileID=21300000&guid=b0afa2c7f74d246659b7be42721f3001&type=3#Burning Fill");
}

.card-icon--freeze {
    background-image: url("project://database/Assets/_Game/UI/Sprites/Freeze Fill.png?fileID=21300000&guid=6983ed9c6091d47f7988bf69fc58ff27&type=3#Freeze Fill");
}

.card-badge {
    position: absolute;
    left: -8px;
    top: 19px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 3px;
    border-color: #ffffff;
}

.card-stack {
    position: absolute;
    right: 14px;
    top: 7px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
}

.card--distinct .card-name {
    color: #ff8a8a;
}

.popup {
    width: 340px;
    max-width: 94%;
    padding-top: 34px;
}

.popup-body {
    background-image: url("project://database/Assets/_Game/UI/Sprites/Popup_Body.png?fileID=21300000&guid=60fa31a8134044130a7dfee8a3312af1&type=3#Popup_Body");
    -unity-slice-left: 250;
    -unity-slice-right: 250;
    -unity-slice-top: 245;
    -unity-slice-bottom: 245;
    -unity-slice-scale: 0.33px;
    padding: 48px 22px 26px 22px;
    align-items: center;
}

.popup-header {
    position: absolute;
    top: 0;
    left: 26px;
    right: 26px;
    height: 66px;
    align-items: center;
    justify-content: center;
    padding-bottom: 8px;
}

.popup-header-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background-image: url("project://database/Assets/_Game/UI/Sprites/Popup_Header.png?fileID=21300000&guid=68a9bef0dbb44479c8e012f8e519de6a&type=3#Popup_Header");
    -unity-background-scale-mode: stretch-to-fill;
}

.popup-header-bg--left {
    left: 0;
}

.popup-header-bg--right {
    right: 0;
    scale: -1 1;
}

.popup-title {
    font-size: 27px;
    color: #ffffff;
    -unity-text-outline-width: 0.9px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.8);
}

.popup-inside {
    width: 100%;
    height: 190px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/Popup_inside.png?fileID=21300000&guid=398729e133d024771bb0833f699f7ae5&type=3#Popup_inside");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 125;
    -unity-slice-bottom: 125;
    -unity-slice-scale: 0.4px;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
}

.popup-heart {
    width: 96px;
    height: 88px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/heart.png?fileID=21300000&guid=226c31b52685643a9946f8a7689d2d9e&type=3#heart");
    -unity-background-scale-mode: scale-to-fit;
}

.popup-buttons {
    align-items: center;
}

.btn-shell {
    width: 219px;
    height: 61px;
    margin: 0 0 12px 0;
    padding: 1.5px 1.5px 1.5px 1.5px;
    background-image: url("project://database/Assets/_Game/UI/Sprites/Button_Back_darkSurface.png?fileID=21300000&guid=e499a8024ee79427f8db0d8ab896a696&type=3#Button_Back_darkSurface");
    -unity-slice-left: 142;
    -unity-slice-right: 142;
    -unity-slice-top: 146;
    -unity-slice-bottom: 146;
    -unity-slice-scale: 0.2px;
}

.btn--revive, .btn--retry {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0 0 6px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 129;
    -unity-slice-right: 129;
    -unity-slice-top: 130;
    -unity-slice-bottom: 130;
    -unity-slice-scale: 0.2px;
    font-size: 22px;
    color: #ffffff;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.55);
}

.btn--revive {
    background-image: url("project://database/Assets/_Game/UI/Sprites/Green_Button.png?fileID=21300000&guid=1046c0f6f739a42ffaa7b897ec4dd45d&type=3#Green_Button");
}

.btn--retry {
    background-image: url("project://database/Assets/_Game/UI/Sprites/Blue_Button.png?fileID=21300000&guid=3682a020ebe4f4973b3986fe4b4d8b21&type=3#Blue_Button");
}

.btn--revive:active, .btn--retry:active {
    scale: 0.96;
}

.screens .popup-title, .screens .btn--revive, .screens .btn--retry {
    -unity-font-style: bold;
}

.stage-col {
    align-items: center;
}

.wave-info {
    margin-top: 3px;
    font-size: 11px;
    color: #ffffff;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.75);
}
